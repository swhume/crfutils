# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# PyInstaller (a future packaging/ spec would be tracked explicitly)
*.manifest
*.spec

# Unit test / coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Environments
.env
.venv
env/
venv/

# Type checkers and linters
.mypy_cache/
.ruff_cache/

# IDEs
.idea/
.vscode/

# generated by the CLI examples and the tests; nothing reads them, so they are not tracked
tests/data/*.html
tests/data/*.pdf
tests/data/*.pagerefs.json
*_acrf.pdf
*.pagerefs.json
